# AgroMitra Root & Backend Environment Variables (Example Template)
# Copy this file to backend/.env for local development

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Configuration (future MongoDB integration)
MONGODB_URI=mongodb://localhost:27017/agromitra

# Authentication & Security (future JWT configuration)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
